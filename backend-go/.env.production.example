# ============================================================
# Go 后端生产环境变量模板
# ============================================================
APP_NAME="Platform Backend"
APP_ENV="production"
DEBUG="false"
LOG_LEVEL="INFO"
# 安全密钥（生产必须修改，openssl rand -hex 32）
SECRET_KEY="please-change-this-to-a-random-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="1440"
# License 签名密钥（生产必须修改）
LICENSE_SECRET_KEY="please-change-this-license-secret"
LICENSE_ACTIVATION_URL=""
LICENSE_MACHINE_CODE_OVERRIDE=""
# 数据库（SQLite 示例；绝对路径使用四个斜杠）
DATABASE_URL="sqlite+aiosqlite:////opt/platform/data/app.db"
# PostgreSQL 示例：
# DATABASE_URL="postgresql+asyncpg://platform:platform-change-me@127.0.0.1:5432/platform"
# 服务监听
SERVER_HOST="0.0.0.0"
SERVER_PORT="8000"
READ_TIMEOUT="10s"
WRITE_TIMEOUT="10s"
SHUTDOWN_TIMEOUT="10s"
# 前端产物路径
FRONTEND_DEPLOY_DIR="/opt/platform/frontend/deploy"
# CORS（生产建议改为具体域名，逗号分隔）
CORS_ORIGINS="*"
# 模块管理
MODULES_DIR="src/modules"
MODULE_UPLOAD_DIR="/opt/platform/uploads/modules"
MODULE_ZIP_MAX_SIZE="52428800"
MODULE_ZIP_MAX_TOTAL="209715200"
MODULE_ZIP_MAX_FILES="2000"
