# ============================================================
# 应用配置
# ============================================================
APP_NAME=Platform Backend
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-in-production-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
LOG_LEVEL=DEBUG

# ============================================================
# 数据库配置
# ============================================================
DATABASE_URL=sqlite+aiosqlite:///./app.db
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=1h

# ============================================================
# 服务监听
# ============================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
READ_TIMEOUT=10s
WRITE_TIMEOUT=10s
SHUTDOWN_TIMEOUT=10s

# ============================================================
# CORS
# ============================================================
CORS_ORIGINS=*

# ============================================================
# 前端产物路径
# ============================================================
FRONTEND_DEPLOY_DIR=../frontend/deploy/

# ============================================================
# 前端动态配置
# ============================================================
# 前端菜单与子应用配置文件路径（YAML / JSON）。
# 为空时使用默认值 configs/frontend.yaml。
# 生产环境建议指向包外可写路径，便于独立运维：
#   FRONTEND_CONFIG_PATH=/opt/platform/configs/frontend.yaml
FRONTEND_CONFIG_PATH=configs/frontend.yaml

# ============================================================
# 模块管理配置
# ============================================================
MODULES_DIR=src/modules
MODULE_UPLOAD_DIR=./uploads/modules
MODULE_ZIP_MAX_SIZE=52428800
MODULE_ZIP_MAX_TOTAL=209715200
MODULE_ZIP_MAX_FILES=2000

# ============================================================
# License 管理配置
# ============================================================
# License 签名密钥（HMAC-SHA256）。生产环境必须显式配置为随机字符串。
# 生成方式：openssl rand -hex 32
LICENSE_SECRET_KEY=change-this-license-secret-in-production
# 在线激活服务地址（可选）。未配置时 /api/v1/license/activate 返回 50005。
# 示例：https://license.example.com/api
LICENSE_ACTIVATION_URL=
# 机器码覆盖（仅开发/测试使用）。为空时基于 MAC + 平台信息自动生成。
# 固定为开发环境的值可避免因网络接口变化导致的机器码变化。
LICENSE_MACHINE_CODE_OVERRIDE=

# ============================================================
# Core 引擎配置
# ============================================================
CORE_ROOT=/opt/plats_tool/core

# ============================================================
# 安装根目录与派生路径
#
# 下列字段留空时会自动派生自 PLATS_INSTALL_ROOT：
#   PLATS_CORE_GO_BIN          → <install_root>/core/bin/core
#   PLATS_CORE_GO_WHITEBOX_BIN → <install_root>/core/bin/whitebox_sm4
#   PLATS_CORE_GO_OPENSSL_BIN  → <install_root>/core/run/bin/openssl
#   PLATS_CERT_ROOT            → <install_root>/user_data/cert
#   PLATS_CA_ROOT              → <cert_root>/ca
#   PLATS_SERVER_ROOT          → <cert_root>/server
#   PLATS_CERT_TMP_DIR         → <cert_root>/tmp
#   MEDIA_ROOT                 → <install_root>/user_data/media
#
# ★ 铜锁 openssl 二进制在 <install_root>/core/run/bin/openssl；
#   动态库在 <install_root>/core/libs/tongsuo/libs（含 ossl-modules/oqsprovider.so）。
# ============================================================
PLATS_INSTALL_ROOT=/opt/plats_tool
PLATS_CORE_GO_BIN=/opt/plats_tool/core/bin/core
CORE_DISPATCH_PATH=/opt/plats_tool/core/bin/core
PLATS_CORE_GO_WHITEBOX_BIN=/opt/plats_tool/core/bin/whitebox_sm4
PLATS_CORE_GO_OPENSSL_BIN=/opt/plats_tool/core/run/bin/openssl
PLATS_CERT_ROOT=/opt/plats_tool/user_data/cert
PLATS_CA_ROOT=/opt/plats_tool/user_data/cert/ca
PLATS_SERVER_ROOT=/opt/plats_tool/user_data/cert/server
PLATS_CERT_TMP_DIR=/opt/plats_tool/user_data/cert/tmp

# core 调用超时（毫秒）
CORE_TIMEOUT_MS=30000
# 最大并发
CORE_MAX_CONCURRENCY=8

# ============================================================
# 媒体管理（音视频模块）
#
# 目录结构（首次启动自动创建）：
#   <MediaRoot>/
#   ├── video/                 点播视频文件
#   │   └── thumbnails/        视频缩略图
#   ├── audio/                 点播音频文件
#   └── tmp/uploads/<id>/      分片上传临时目录（2h 过期清理）
# ============================================================
# 媒体根目录：留空则派生为 <PLATS_INSTALL_ROOT>/user_data/media
MEDIA_ROOT=/opt/plats_tool/user_data/media
# 分片大小（字节），默认 5MB。前端按此值切片。
MEDIA_CHUNK_SIZE=5242880
# 上传会话过期时间（超时未合并的 tmp 目录被清理）
MEDIA_SESSION_TTL=2h
# ffprobe / ffmpeg 路径：缺省走 $PATH（apt install ffmpeg 后默认可达）。
# 若未安装或路径不可达：上传仍成功，但 duration/resolution/thumbnail 置空。
MEDIA_FFPROBE_PATH=ffprobe
MEDIA_FFMPEG_PATH=ffmpeg

# ============================================================
# ZLMediaKit（音视频模块）
#
# 部署结构（由 core/libs/Makefile 保证）：
#   /opt/plats_tool/video/
#   ├── run/bin/MediaServer
#   ├── libs/ZLMediaKit/*.so
#   └── conf/zlmediakit/config.ini
#
# ★ 端口与 secret 自动读取：
#   以下三项**留空/删除**，后端启动时会自动读取
#   /opt/plats_tool/video/conf/zlmediakit/config.ini：
#     [http] port     → ZLM_HTTP_PORT
#     [api]  secret   → ZLM_SECRET
#   并自动派生 ZLM_BASE_URL=http://127.0.0.1:<port>
#
#   若 config.ini 里的 secret 仍是 ZLM 官方示例值 035c...，
#   后端会主动生成随机 secret 写回 ini（避免 ZLM 启动时自动改写）。
#
#   仅当对接**外部 ZLM**（非本机托管）时，才需要显式配置以下三项：
#     ZLM_BASE_URL=http://other-host:8080
#     ZLM_SECRET=xxx
#     ZLM_HTTP_PORT=8080
# ============================================================
# （留空）后端自动从 config.ini [http] port 读取
ZLM_HTTP_PORT=
# （留空）后端自动从 config.ini [api] secret 读取
ZLM_SECRET=
# （留空）后端自动派生为 http://127.0.0.1:<ZLM_HTTP_PORT>
ZLM_BASE_URL=

# 对外可达的 host（拼播放地址用，浏览器必须能访问）。
# ★ 必须写客户端可达的 IP/域名，不能是 127.0.0.1（除本机联调外）。
# 你的部署：浏览器访问 http://192.168.56.14:8000，因此这里写 192.168.56.14
ZLM_HTTP_HOST=192.168.56.14
# RTMP / RTC 端口：用于前端拼推流/播放地址。
# 应与 config.ini 的 [rtmp] port / [rtc] port 一致。
ZLM_RTMP_PORT=1935
ZLM_RTC_PORT=8000

# ============================================================
# ZLMediaKit 进程管理
#
# 两种典型部署方式：
#   【开发 / 单机部署】后端托管 ZLM 子进程：
#     ZLM_AUTO_START=true
#     ZLM_ENGINE_SHUTDOWN_ON_EXIT=true
#   【生产环境】由 systemd 独立管理 ZLM（推荐）：
#     ZLM_AUTO_START=false
#     ZLM_ENGINE_SHUTDOWN_ON_EXIT=false
#   后端仅做探活 + 状态查询 + /live/engine/{start,stop} API；
#   start 会因"外部进程已在运行"返回 409，stop 拒绝操作外部进程。
# ============================================================
# 后端启动时若 ZLM 探活失败则自动托管拉起
ZLM_AUTO_START=true
# 后端退出时是否 kill 本进程托管过的 ZLM 子进程
ZLM_ENGINE_SHUTDOWN_ON_EXIT=true
# 以下路径留空则自动派生自 <PLATS_INSTALL_ROOT>/video/...：
#   ZLM_ENGINE_BIN        → <video>/run/bin/MediaServer
#   ZLM_ENGINE_CONFIG     → <video>/conf/zlmediakit/config.ini
#   ZLM_ENGINE_LIB_DIR    → <video>/libs/ZLMediaKit     （作为 LD_LIBRARY_PATH）
#   ZLM_ENGINE_WORK_DIR   → <video>/run/bin
#   ZLM_ENGINE_LOG_FILE   → <video>/logs/MediaServer.log（仅托管时重定向）
# 显式配置示例（非标准部署位置时使用）：
# ZLM_ENGINE_BIN=/opt/plats_tool/video/run/bin/MediaServer
# ZLM_ENGINE_CONFIG=/opt/plats_tool/video/conf/zlmediakit/config.ini
# ZLM_ENGINE_LIB_DIR=/opt/plats_tool/video/libs/ZLMediaKit
# ZLM_ENGINE_WORK_DIR=/opt/plats_tool/video/run/bin
# ZLM_ENGINE_LOG_FILE=/opt/plats_tool/video/logs/MediaServer.log

# ============================================================
# 对外可达 URL（音视频模块）
#
# 媒体列表返回的 thumbnail / play_url / download_url 均以此为前缀。
# 为空时回退：http://{SERVER_HOST}:{SERVER_PORT}
#   SERVER_HOST 为 0.0.0.0/:: 时自动使用 127.0.0.1。
#
# 你的部署：浏览器通过 192.168.56.14:8000 访问，因此显式配置
# ============================================================
PUBLIC_BASE_URL=http://192.168.56.14:8000
