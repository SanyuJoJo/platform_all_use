# ============================================================
# 应用配置
# ============================================================
APP_NAME=Platform Backend
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-in-production-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
LOG_LEVEL=DEBUG

# ============================================================
# 数据库配置
# ============================================================
DATABASE_URL=sqlite+aiosqlite:///./app.db
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=1h

# ============================================================
# 服务监听
# ============================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
READ_TIMEOUT=10s
WRITE_TIMEOUT=10s
SHUTDOWN_TIMEOUT=10s

# ============================================================
# CORS
# ============================================================
CORS_ORIGINS=*

# ============================================================
# 前端产物路径（后续静态托管使用）
# ============================================================
FRONTEND_DEPLOY_DIR=

# ============================================================
# 模块管理配置（P3 阶段新增）
# ============================================================
# 模块源码根目录（相对 backend-go 工作目录）
MODULES_DIR=src/modules
# 模块上传/安装的受控根目录（source_path 白名单）
MODULE_UPLOAD_DIR=./uploads/modules
# ZIP 单文件大小上限（字节），默认 50MB
MODULE_ZIP_MAX_SIZE=52428800
# ZIP 解压后总大小上限（字节），默认 200MB
MODULE_ZIP_MAX_TOTAL=209715200
# ZIP 文件数量上限，默认 2000
MODULE_ZIP_MAX_FILES=2000
