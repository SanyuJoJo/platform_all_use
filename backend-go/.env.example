# ============================================================
# 应用配置
# ============================================================
APP_NAME=Platform Backend
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-in-production-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
LOG_LEVEL=DEBUG
# ============================================================
# 数据库配置
# ============================================================
# 开发默认 SQLite，兼容 Python 版 DATABASE_URL 写法
DATABASE_URL=sqlite+aiosqlite:///./app.db
# PostgreSQL 示例（生产推荐；注意：P0 阶段迁移仅支持 SQLite）：
# DATABASE_URL=postgresql+asyncpg://platform:platform-change-me@localhost:5432/platform
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=1h
# ============================================================
# 服务监听
# ============================================================
# 优先读取 SERVER_HOST / SERVER_PORT；
# 未设置时回退到 HOST / PORT（与 Python 版兼容）。
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# 兼容 Python 环境的简写（两个都可用，SERVER_* 优先）：
# HOST=0.0.0.0
# PORT=8000
READ_TIMEOUT=10s
WRITE_TIMEOUT=10s
SHUTDOWN_TIMEOUT=10s
# ============================================================
# CORS
# ============================================================
# 逗号分隔的白名单；开发环境可用 "*"。
# 生产环境必须显式指定域名，否则启动时记录 ERROR 日志。
CORS_ORIGINS=*
# ============================================================
# 前端产物路径（后续静态托管使用）
# ============================================================
FRONTEND_DEPLOY_DIR=
