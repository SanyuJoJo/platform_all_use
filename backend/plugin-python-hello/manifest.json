{
  "name": "python-hello",
  "version": "1.0.0",
  "description": "Python Hello plugin",
  "author": "yourorg",
  "mode": "managed",
  "runtime": "http",
  "entrypoint": "python3",
  "exec_args": ["main.py"],
  "work_dir": ".",
  "port": 9100,
  "env": {
    "PLUGIN_PORT": "9100"
  },
  "routes": [
    {
      "path": "/api/hello",
      "methods": ["GET"],
      "priority": 100,
      "strip_prefix": false
    },
    {
      "path": "/api/hello/",
      "methods": ["GET", "POST", "PUT", "DELETE"],
      "priority": 90,
      "strip_prefix": true
    }
  ]
}
