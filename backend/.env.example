# 应用配置
APP_NAME=Platform Backend
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-in-production-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# 数据库配置（SQLite 开发）
DATABASE_URL=sqlite+aiosqlite:///./app.db
# 生产可切换为 PostgreSQL
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/db
# 日志级别
LOG_LEVEL=DEBUG
