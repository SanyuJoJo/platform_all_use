# 应用配置
APP_NAME=Platform Backend
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-in-production-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite+aiosqlite:///./app.db
LOG_LEVEL=DEBUG
# CORS 允许的源，逗号分隔。
# 开发环境可用 "*"（允许所有源）；生产环境应指定具体域名，如 "https://example.com,https://app.example.com"
# 若此配置留空或仅包含空白字符，系统将自动回退为 "*" 并记录警告日志。
CORS_ORIGINS=*


# ============================================================
# 模块管理配置（v1.1+）
# ============================================================
# 模块源码根目录（相对 backend 工作目录）
MODULES_DIR=src/modules
# 模块上传/安装的受控根目录（source_path 白名单）
MODULE_UPLOAD_DIR=./uploads/modules
# ZIP 单文件大小上限（字节），默认 50MB
MODULE_ZIP_MAX_SIZE=52428800
# ZIP 解压后总大小上限（字节），默认 200MB
MODULE_ZIP_MAX_TOTAL=209715200
# ZIP 文件数量上限，默认 2000
MODULE_ZIP_MAX_FILES=2000
# ============================================================
# License 管理配置
# ============================================================
# License 签名密钥（HMAC-SHA256）。生产环境必须显式配置为随机字符串。
# 生成方式：openssl rand -hex 32
LICENSE_SECRET_KEY=change-this-license-secret-in-production
# 在线激活服务地址（可选）。未配置时 /api/v1/license/activate 返回 50005。
# 示例：https://license.example.com/api
LICENSE_ACTIVATION_URL=
# 机器码覆盖（仅开发/测试使用）。为空时基于 MAC + 平台信息自动生成。
# 固定为开发环境的值可避免因网络接口变化导致的机器码变化。
LICENSE_MACHINE_CODE_OVERRIDE=
