# ============================================================
# 生产环境变量模板（v1.1）
#
# v1.1 变更：
#   - P0-2 / P1-1：新增 FRONTEND_DEPLOY_DIR，与 Docker / compose 保持一致。
#   - P0-4：SQLite 数据库路径改为 ./data/app.db（目录挂载场景）。
#   - P1-5：PostgreSQL 示例密码统一为 platform-change-me。
#
# 使用方式：
#   cp .env.production.example .env
#   # 按实际环境修改后启动
#
# 安全提示：
#   - SECRET_KEY / LICENSE_SECRET_KEY 必须使用随机值
#   - 生成方式：openssl rand -hex 32
#   - 请勿将 .env 提交到版本控制
# ============================================================
# ============================================================
# 应用配置
# ============================================================
APP_NAME=Platform Backend
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
# ============================================================
# 安全配置（生产环境必须修改）
# ============================================================
# JWT 签名密钥（openssl rand -hex 32）
SECRET_KEY=please-change-this-to-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# ============================================================
# 数据库配置
# ============================================================
# 方案 A：SQLite（单机 / 小规模部署，推荐 WORKERS=1）
# 目录挂载场景（Docker）：DATABASE_URL 使用 4 个斜杠表示绝对路径
DATABASE_URL=sqlite+aiosqlite:////app/data/app.db
# 本地非容器场景（相对 backend/ 目录）：
# DATABASE_URL=sqlite+aiosqlite:///./app.db
# 方案 B：PostgreSQL（生产推荐，可调高 WORKERS）
# 密码与 docker-compose.yml 中 POSTGRES_PASSWORD 默认值保持一致
# DATABASE_URL=postgresql+asyncpg://platform:platform-change-me@postgres:5432/platform
# ============================================================
# 前端产物路径（v1.1 新增）
# ============================================================
# Docker / compose / 部署包中必须显式设置，与 volume 挂载点一致
# 本地非容器场景可留空，代码将回退到 `<repo>/frontend/deploy`
FRONTEND_DEPLOY_DIR=/app/frontend/deploy
# ============================================================
# CORS 配置（生产必须显式指定域名）
# ============================================================
# 逗号分隔；禁止使用 "*"
CORS_ORIGINS=https://your-domain.example.com,https://app.your-domain.example.com
# ============================================================
# 服务监听
# ============================================================
HOST=0.0.0.0
PORT=8000
# SQLite 单写者限制，WORKERS 建议为 1；PostgreSQL 建议 CPU 核数 * 2
WORKERS=1
# ============================================================
# 模块管理配置
# ============================================================
MODULES_DIR=src/modules
MODULE_UPLOAD_DIR=./uploads/modules
MODULE_ZIP_MAX_SIZE=52428800
MODULE_ZIP_MAX_TOTAL=209715200
MODULE_ZIP_MAX_FILES=2000
# ============================================================
# License 管理配置
# ============================================================
# License 签名密钥（openssl rand -hex 32）
LICENSE_SECRET_KEY=please-change-this-license-secret
# 在线激活服务地址（可选）
LICENSE_ACTIVATION_URL=
# 机器码覆盖（仅开发/测试，生产留空）
LICENSE_MACHINE_CODE_OVERRIDE=
