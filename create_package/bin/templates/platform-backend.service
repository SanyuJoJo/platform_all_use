[Unit]
Description=Platform Backend Service
After=network.target
[Service]
Type=simple
User=@RUN_USER@
Group=@RUN_GROUP@
WorkingDirectory=@BACKEND_DIR@
EnvironmentFile=@ENV_FILE@
ExecStart=@BACKEND_DIR@/bin/server
Restart=on-failure
RestartSec=5
LimitNOFILE=65535
[Install]
WantedBy=multi-user.target
