{
  "name": "module-crypto-console",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "铜锁证书管理控制台 qiankun 子应用",
  "scripts": {
    "dev": "VITE_QIANKUN_USE_DEV_MODE=false vite --port 3010",
    "dev:qiankun": "VITE_QIANKUN_USE_DEV_MODE=true vite --port 3010",
    "build": "vue-tsc -p tsconfig.json --noEmit && vite build",
    "build:prod": "vue-tsc -p tsconfig.json --noEmit && vite build --mode production",
    "preview": "vite preview --port 3010",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf node_modules/.vite dist"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "naive-ui": "^2.38.0",
    "pinia": "^2.1.7",
    "qiankun": "^2.10.16",
    "vue": "^3.4.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/tsconfig": "^0.5.1",
    "typescript": "5.6.2",
    "vite": "^5.0.0",
    "vite-plugin-qiankun": "^1.0.12",
    "vue-tsc": "2.0.29"
  }
}
