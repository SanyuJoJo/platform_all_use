# ============================================================
# media 子应用生产构建环境变量
#
# 部署约定：前端与后端同源（由同一 nginx/Tengine 反向代理 /api/v1 → 后端）
# 因此 API 走相对路径，不要写死绝对地址。
# ============================================================

# API 基础地址：留空 → baseURL = '/api/v1'，请求自动跟随浏览器域名。
# 仅当前后端真正跨域分离部署时，才填写后端可达地址（如 http://api.example.com:18000）。
VITE_API_BASE_URL=

# 子应用 ID（qiankun 路由注册用，保持不变）
VITE_MODULE_ID=media

# dev server 端口（仅影响 npm run dev，不影响 build，保持不变）
VITE_PORT=3005

# ZLMediaKit 地址：前端代码不直接使用此变量。
# 直播播放地址由后端 GET /api/v1/live/streams 与 /live/play/:id 返回的完整 URL 提供，
# 其中的 host/port 由后端 .env 的 ZLM_HTTP_HOST / ZLM_HTTP_PORT 决定。
# 保留空值，避免构建产物中意外出现不可达的绝对地址。
VITE_ZLM_BASE_URL=
