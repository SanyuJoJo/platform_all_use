#============================================================
# 前端环境变量配置模板
# 复制为 .env.local 并根据实际环境修改
# ============================================================
# ---------- API 配置 ----------
# 后端服务地址（开发环境通过代理转发）
VITE_API_BASE_URL=http://localhost:18000
# ---------- 主应用配置 ----------
# ---------- 子应用端口配置 ----------
# 各子应用开发端口（确保不冲突）
VITE_SUBAPP_AUTH_PORT=3001
VITE_SUBAPP_MODULE_MANAGER_PORT=3002
VITE_SUBAPP_AUDIT_LOG_PORT=3003
VITE_SUBAPP_LICENSE_PORT=3004
# ---------- 子应用入口配置 ----------
# 各子应用 qiankun entry 地址
VITE_SUBAPP_ENTRY_AUTH=//localhost:3001/
VITE_SUBAPP_ENTRY_MODULE_MANAGER=//localhost:3002/
VITE_SUBAPP_ENTRY_AUDIT_LOG=//localhost:3003/
VITE_SUBAPP_ENTRY_LICENSE=//localhost:3004/
# ---------- 模板配置 ----------
# 复制 _template 创建新模块时必须修改此项
VITE_MODULE_ID=template
# 模板子应用默认端口（可自定义）
VITE_TEMPLATE_PORT=3001

# 主应用端口
VITE_APP_HOST=0.0.0.0
VITE_APP_PORT=3000
# 子应用入口备选前缀（当后端 entry_frontend 为空时使用）
VITE_DEFAULT_ENTRY_PREFIX=/sub-apps/
VITE_USE_MOCK=true
