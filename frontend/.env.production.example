# ============================================================
# 生产环境变量模板
# 复制为 .env.production.local 并按实际部署修改
# ============================================================
# 后端 API 基础地址。生产推荐同域，留空即可，Axios 会使用 /api/v1
VITE_API_BASE_URL=
# 主应用基础路径
VITE_BASE_PATH=/
# 子应用静态资源部署前缀
VITE_SUBAPP_BASE_PREFIX=/sub-apps
# 生产关闭 qiankun 开发模式
VITE_QIANKUN_USE_DEV_MODE=false
# 生产关闭 Mock
VITE_USE_MOCK=false
# ============================================================
# 子应用专用变量（由 build-all.mjs 注入，也可在子应用 .env.local 覆盖）
# ============================================================
# 子应用模块 ID（必须与后端模块表 module_manager_module.id 一致）
# 示例：auth / module_manager / audit_log / license
# VITE_MODULE_ID=auth
# 子应用部署目录名（可与 MODULE_ID 不同，例如 module_manager 对应 module-manager）
# VITE_SUBAPP_DIR=auth
# 子应用开发端口
# VITE_PORT=3001
# 子应用生产静态资源基础路径（一般由 build-all.mjs 计算，无需手动设置）
# VITE_PUBLIC_PATH=/sub-apps/auth/
