{
  "name": "frontend-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:all": "concurrently \"pnpm run dev:main\" \"pnpm run dev:subapp\"",
    "dev:main": "pnpm --filter main-app dev",
    "dev:subapp": "pnpm --filter './sub-apps/*' dev",
    "build:all": "pnpm run build:main && pnpm run build:subapps",
    "build:main": "pnpm --filter main-app build",
    "build:subapps": "pnpm --filter './sub-apps/*' build",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "format": "prettier --write .",
    "prepare": "husky install",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.21.1",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vitest": "^1.2.0",
    "vue-tsc": "^1.8.27"
  },
  "lint-staged": {
    "*.{vue,ts,js}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.18.0",
    "pnpm": ">=8.0.0"
  }
}
