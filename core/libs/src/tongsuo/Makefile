	@if cmp apps/lib/libapps-lib-log.d.tmp apps/lib/libapps-lib-log.d > /dev/null 2> /dev/null; then \
		rm -f apps/lib/libapps-lib-log.d.tmp; \
	else \
		mv apps/lib/libapps-lib-log.d.tmp apps/lib/libapps-lib-log.d; \
	fi
